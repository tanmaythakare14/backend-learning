{
  "name": "@myapp/api",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0"
  },
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/main.js",
    "dev": "npx nodemon --exec ts-node src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "swagger:generate": "ts-node src/common/utils/swagger/generate-swagger.ts",
    "----------- TYPEORM MIGRATION SCRIPTS -----------": "",
    "migration:create": "npx typeorm migration:create",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d src/config/data-source.ts",
    "----------- DO NOT USE - DISABLED -----------": "",
    "migration:generate:DISABLED": "echo 'ERROR: migration:generate is DISABLED. Write raw SQL migrations manually.' && exit 1"
  }
}

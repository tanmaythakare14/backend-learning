# =============================================================================
# Environment Variables Template
# =============================================================================
# 1. Copy this file to .env: cp env.template .env
# 2. Fill in actual values for your environment
# 3. NEVER commit .env to version control

# Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL / AWS RDS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=myapp_dev

# SSL (Required for AWS RDS in production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Logging
DB_LOGGING=false
LOG_LEVEL=info

# Auth0 (Applications > APIs > <your api> > Settings in the Auth0 dashboard)
# Used to validate incoming access tokens via JWKS — must match the frontend's
# VITE_AUTH0_DOMAIN / VITE_AUTH0_AUDIENCE in apps/web/.env.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

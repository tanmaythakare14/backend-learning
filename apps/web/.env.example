# Encryption key for secure localStorage/sessionStorage
VITE_ENCRYPTION_KEY=change-me-in-production

# API base URL
VITE_API_URL=http://localhost:4000

# Set to 'true' to silence all logs (useful in CI)
VITE_DISABLE_LOGGING=false

# Set to 'true' ONLY for local debugging — never in production
VITE_DISABLE_PHI_REDACTION=false

# Auth0 (Applications > Applications > <your app> > Settings in the Auth0 dashboard)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Optional — only needed once the NestJS API is registered as an Auth0 API
# (Applications > APIs > <your api> > Settings > Identifier)
VITE_AUTH0_AUDIENCE=

# Feedback widget (@mindbowser_inc/ui-feedback-plugin) — floating button for annotated screenshots
# and comments. On by default in development; in production it stays off unless this is 'true'
# (it screenshots whatever is on screen, which can include student contact details).
VITE_FEEDBACK_ENABLED=
# 'local' (default — everything stays in this browser), 'supabase' or 'firebase'
VITE_FEEDBACK_PROVIDER=local
VITE_FEEDBACK_PROJECT_KEY=cognify
# Only for provider=supabase
VITE_FEEDBACK_SUPABASE_URL=
VITE_FEEDBACK_SUPABASE_ANON_KEY=
# Only for provider=firebase
VITE_FEEDBACK_FIREBASE_API_KEY=
VITE_FEEDBACK_FIREBASE_AUTH_DOMAIN=
VITE_FEEDBACK_FIREBASE_PROJECT_ID=
VITE_FEEDBACK_FIREBASE_STORAGE_BUCKET=

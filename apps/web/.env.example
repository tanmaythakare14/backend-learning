# Encryption key for secure localStorage/sessionStorage
VITE_ENCRYPTION_KEY=change-me-in-production

# API base URL
VITE_API_URL=http://localhost:4000

# Set to 'true' to silence all logs (useful in CI)
VITE_DISABLE_LOGGING=false

# Set to 'true' ONLY for local debugging — never in production
VITE_DISABLE_PHI_REDACTION=false
